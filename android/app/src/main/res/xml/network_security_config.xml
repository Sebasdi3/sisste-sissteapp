<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Permite tráfico HTTP sin cifrar SOLO hacia el servidor SISSTe
        dentro de la red interna (172.17.102.191, puerto 3000).
        Es una excepción puntual mientras el backend no tenga TLS.
        El resto del tráfico de la app sigue exigiendo HTTPS.

        Si cambia la IP del servidor, actualízala aquí también: sin
        esto Android bloquea la conexión aunque api_config.dart esté bien.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">172.17.102.191</domain>
    </domain-config>
</network-security-config>
